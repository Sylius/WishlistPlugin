<container xmlns="http://symfony.com/schema/dic/services" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <service
                id="sylius.wishlist_plugin.twig.component.wishlist_details.actions.create_new_wishlist_button"
                class="Sylius\WishlistPlugin\Twig\Component\WishlistDetails\Actions\CreateNewWishlistButtonComponent"
        >
            <argument type="service" id="messenger.default_bus" />
            <argument type="service" id="request_stack" />
            <argument type="service" id="translator" />
            <argument type="service" id="sylius.context.channel" />
            <argument type="service" id="router" />

            <tag name="sylius.live_component.shop" key="sylius_shop:wishlist:create_new_wishlist_button"/>
        </service>
        <service
                id="sylius.wishlist_plugin.twig.component.wishlist_group.item.buttons.edit_wishlist_button"
                class="Sylius\WishlistPlugin\Twig\Component\WishlistGroup\Item\Buttons\EditWishlistButtonComponent"
        >
            <argument type="service" id="sylius_wishlist_plugin.repository.wishlist" />
            <argument type="service" id="messenger.default_bus" />
            <argument type="service" id="request_stack" />
            <argument type="service" id="translator" />
            <argument type="service" id="router" />

            <tag name="sylius.live_component.shop" key="sylius_shop:wishlist:edit_wishlist_button"/>
        </service>

        <service
                id="sylius.wishlist_plugin.twig.component.wishlist_group.item.buttons.remove_wishlist_button"
                class="Sylius\WishlistPlugin\Twig\Component\WishlistGroup\Item\Buttons\RemoveWishlistButtonComponent"
        >
            <argument type="service" id="router" />
            <argument type="service" id="messenger.default_bus" />
            <argument type="service" id="sylius_wishlist_plugin.repository.wishlist" />
            <tag name="sylius.live_component.shop" key="sylius_shop:wishlist:remove_wishlist_button"/>
        </service>

        <service
                id="sylius.wishlist_plugin.twig.component.wishlist_details.collective_actions.copy_to_wishlist"
                class="Sylius\WishlistPlugin\Twig\Component\WishlistDetails\CollectiveActions\CopyToWishlistComponent"
        >
            <tag name="sylius.live_component.shop" key="sylius_shop:wishlist:copy_to_wishlist"/>
        </service>
        <service
                id="sylius.wishlist_plugin.twig.component.wishlist_details.items"
                class="Sylius\WishlistPlugin\Twig\Component\WishlistDetails\WishlistItemsComponent"
        >
            <tag name="sylius.live_component.shop" key="sylius_shop:wishlist:items"/>
        </service>
        <service
                id="sylius.wishlist_plugin.twig.component.wishlist_group.item.wishlist_item"
                class="Sylius\WishlistPlugin\Twig\Component\WishlistGroup\Item\WishlistItemComponent"
        >
            <argument type="service" id="sylius_wishlist_plugin.repository.wishlist" />
            <argument type="service" id="messenger.default_bus" />
            <argument type="service" id="request_stack" />
            <argument type="service" id="translator" />
            <argument type="service" id="router" />
            <tag name="sylius.live_component.shop" key="sylius_shop:wishlist:item"/>
        </service>

        
    </services>
</container>
