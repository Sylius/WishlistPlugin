{
    "name": "sylius/wishlist-plugin",
    "type": "sylius-plugin",
    "description": "Wishlist plugin for Sylius.",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "sylius/sylius": "^2.0.7",
        "sylius/telemetry": "^1.0",
        "sylius/pdf-generation-bundle": "^1.0",
        "dompdf/dompdf": "^2.0 || ^3.1"
    },
    "require-dev": {
        "behat/behat": "^3.22 || 4.0.0-alpha1",
        "behat/mink": "^1.10 || ^1.13",
        "friends-of-behat/mink-browserkit-driver": "^1.6.3",
        "friends-of-behat/mink-debug-extension": "^2.2",
        "friends-of-behat/mink-extension": "^2.7 || 3.0.0-alpha1",
        "friends-of-behat/page-object-extension": "^0.3 || ^0.4",
        "friends-of-behat/symfony-extension": "^2.6.2",
        "friends-of-behat/variadic-extension": "^1.6",
        "nelmio/alice": "^3.10",
        "nyholm/psr7": "^1.8",
        "phpunit/phpunit": "^10.5",
        "sylius/sylius-rector": "^3.0",
        "sylius/test-application": "^2.0.0@alpha",
        "sylius-labs/coding-standard": "^4.4",
        "sylius-labs/suite-tags-extension": "~0.2",
        "symfony/browser-kit": "^6.4 || ^7.4 || ^8.0",
        "symfony/debug-bundle": "^6.4 || ^7.4 || ^8.0",
        "symfony/dotenv": "^6.4 || ^7.4 || ^8.0",
        "symfony/http-client": "^6.4 || ^7.4 || ^8.0",
        "symfony/intl": "^6.4 || ^7.4 || ^8.0",
        "symfony/web-profiler-bundle": "^6.4 || ^7.4 || ^8.0",
        "lchrusciel/api-test-case": "^5.0",
        "sylius-labs/behat-chrome-extension": "^1.5",
        "symfony/webpack-encore-bundle": "^2.1",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-webmozart-assert": "^2.0"
    },
   "minimum-stability": "dev",
   "conflict": {
        "api-platform/symfony": "4.3.16"
    },
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Sylius\\WishlistPlugin\\": "src/",
            "Tests\\Sylius\\WishlistPlugin\\": "tests/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sylius\\WishlistPlugin\\": "src/",
            "Tests\\Sylius\\WishlistPlugin\\": "tests/",
            "Sylius\\Tests\\Api\\": "vendor/sylius/sylius/tests/Api/"
        }
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true,
            "rector/extension-installer": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "symfony/thanks": true,
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "preferred-install": {
            "sylius/sylius": "source"
        }
    },
    "extra": {
        "public-dir": "vendor/sylius/test-application/public"
    }
}
