{% extends '@SyliusShop/shared/layout/base.html.twig' %}

{% import '@SyliusShop/shared/messages.html.twig' as messages %}

{% block title %}{{ 'sylius_wishlist_plugin.ui.your_wishlist'|trans }} | {{ parent() }}{% endblock %}

{% block content %}
    <div class="container mt-4 mb-5">
        <h1 class="bb-wishlist-header">
            {{ wishlist.name }}
        </h1>
        {% if sylius.channel is not null %}
            {% set wishlists = findAllByAnonymousAndChannel(sylius.channel) %}
        {% else %}
            {% set wishlists = findAllByAnonymous() %}
        {% endif %}
        {% if wishlists|length > 1 %}
        {% else %}
            <div class="d-flex flex-column flex-lg-row justify-content-between gap-2">
                {% hook 'sylius_shop.wishlist_details.index' with { wishlist: wishlist } %}
            </div>
        {% endif %}

        <div class="my-3"></div>

        {% if wishlist.wishlistProducts.count > 0 %}
            <div class="my-3"></div>

            {{ form_start(form, { attr: { class: 'bb-wishlist ui form', id: "wishlist_form" } }) }}
            <input type="hidden" id="wishlist_selected_indices" value="[]">

            <div id="wishlist">
                {% hook 'sylius_shop.wishlist_details.header' %}

                {% for itemForm in form.items %}
                    {% hook 'sylius_shop.wishlist_details.item' with { itemForm: itemForm, wishlist: wishlist } %}
                    <input type="hidden" name="wishlist_collection[items][{{ loop.index - 1 }}][variant]"
                           value="{{ itemForm.vars.data.wishlistProduct.variant.id }}"/>
                {% endfor %}

                <div class="bb-wishlist-actions flex-column flex-lg-row align-items-stretch align-items-lg-center gap-2">
                    {% hook 'sylius_shop.wishlist_details' with { wishlist: wishlist, wishlists: wishlists } %}
                    {% hook 'sylius_shop.wishlist_details.global_actions' with { form: form, wishlist: wishlist } %}
                </div>
            </div>

            {{ form_row(form._token) }}
            <script>
            (function(){
              function collect(){
                try{
                  var boxes=document.querySelectorAll("input[type=checkbox][name^='wishlist_collection[items]'][name$='[selected]']");
                  var sel=[]; boxes.forEach(function(b){ if(b.checked){ var m=b.name.match(/items\]\[(\d+)\]\[selected\]/); if(m){ sel.push(parseInt(m[1])); } } });
                  var el=document.getElementById('wishlist_selected_indices'); if(el){ el.value=JSON.stringify(sel); }
                }catch(e){ console.error(e); }
              }
              document.addEventListener('change', function(ev){ var t=ev.target; if(t && t.matches && t.matches("input[type=checkbox][name^='wishlist_collection[items]'][name$='[selected]']")){ collect(); } });
              if(document.readyState==='loading'){ document.addEventListener('DOMContentLoaded', collect); } else { collect(); }
            })();
            </script>
            {{ form_end(form, {'render_rest': false} ) }}
        {% else %}
            {{ messages.info('sylius_wishlist_plugin.ui.your_wishlist_is_empty'|trans) }}
        {% endif %}
    </div>
{% endblock %}
