{% extends '@SyliusShop/shared/layout/base.html.twig' %}

{% import '@SyliusShop/shared/messages.html.twig' as messages %}

{% block title %}{{ 'sylius_wishlist_plugin.ui.your_wishlist'|trans }} | {{ parent() }}{% endblock %}

{% block content %}
    <div class="container mt-4 mb-5">
        <h1 class="bb-wishlist-header">
            {{ wishlist.name }}
        </h1>
        {% if sylius.channel is not null %}
            {% set wishlists = findAllByAnonymousAndChannel(sylius.channel) %}
        {% else %}
            {% set wishlists = findAllByAnonymous() %}
        {% endif %}
        {% if wishlists|length > 1 %}
        {% else %}
            <div class="d-flex flex-column flex-lg-row justify-content-between gap-2">
                {% hook 'sylius_shop.wishlist_details.index' with { wishlist: wishlist } %}
            </div>
        {% endif %}

        <div class="my-3"></div>

        {% if wishlist.wishlistProducts.count > 0 %}
            <div class="my-3"></div>

            {{ form_start(form, { attr: { class: 'bb-wishlist ui form', id: "wishlist_form" } }) }}

            {{ component('sylius_shop:wishlist:items', {
                template: '@SyliusWishlistPlugin/wishlist_details/items_component.html.twig',
                form: form,
                wishlist: wishlist,
                wishlists: wishlists,
                wishlistId: wishlist.id
            }) }}

            <div class="bb-wishlist-actions flex-column flex-lg-row align-items-stretch align-items-lg-center gap-2 mt-3">
                {% hook 'sylius_shop.wishlist_details.global_actions' with { form: form, wishlist: wishlist } %}
            </div>

            {{ form_row(form._token) }}
            {{ form_end(form, {'render_rest': false} ) }}
        {% else %}
            {{ messages.info('sylius_wishlist_plugin.ui.your_wishlist_is_empty'|trans) }}
        {% endif %}
    </div>
{% endblock %}
