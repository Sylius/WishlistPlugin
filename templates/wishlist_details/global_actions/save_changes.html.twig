{% set wishlist = hookable_metadata.context.wishlist %}
{% set form = hookable_metadata.context.form %}

<button
        id="{{ form.save.vars.id }}"
        name="{{ form.save.vars.full_name }}"
        class="btn btn-icon btn-secondary"
        data-bb-toggle="wishlist-save"
        {{ sylius_test_html_attribute('wishlist-save-changes') }}
        formaction="{{ path('sylius_wishlist_plugin_shop_locale_wishlist_save_products', { wishlistId: wishlist.id }) }}"
>
    {{ ux_icon('mdi:content-save', {'class': 'icon icon-sm'}) }}
    {{ form.save.vars.label|trans }}
</button>
