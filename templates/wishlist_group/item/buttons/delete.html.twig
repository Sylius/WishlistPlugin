{# Rendered with \Sylius\WishlistPlugin\Twig\Component\WishlistGroup\Item\Buttons\RemoveWishlistButtonComponent #}

<div {{ attributes }}>
<button id="wishlist-delete-button" class="btn btn-sm btn-outline-secondary"
        {{ sylius_test_html_attribute('wishlist-wishlist-remove') }}
        data-action="live#action" data-live-action-param="openModal">
    {{ ux_icon('flowbite:x-outline', {'class': 'icon icon-sm'}) }}
    </button>

{% if this.showModal %}
    <form class="wishlist-confirmation-modal">
        <header class="wishlist-confirmation-modal__header">
            <h2 class="wishlist-confirmation-modal__header--title">
                {{ 'sylius_wishlist_plugin.ui.wishlist_modal_remove_title'|trans }}
            </h2>
        </header>
        <section class="wishlist-confirmation-modal__body">
            {{ 'sylius_wishlist_plugin.ui.wishlist_modal_remove_content'|trans }}
        </section>
        <section class="wishlist-confirmation-modal__confirm">
            <button type="button" class="wishlist-confirmation-modal__confirm--cancel"
                    data-action="live#action" data-live-action-param="closeModal">
                {{ 'sylius_wishlist_plugin.ui.wishlist_modal_remove_cancel'|trans }}
            </button>
            <button type="button" id="remove_wishlist_confirm"
                    class="wishlist-confirmation-modal__confirm--perform"
                    data-action="live#action:prevent" data-live-action-param="remove">
                {{ 'sylius_wishlist_plugin.ui.wishlist_modal_remove_perform'|trans }}
            </button>
        </section>
    </form>
{% endif %}
</div>
