{% set wishlist = hookable_metadata.context.wishlist %}
{% set product = hookable_metadata.context.product %}

<li {{ attributes }}>
    <button
            type="button"
            class="dropdown-item"
            data-action="live#action:prevent" data-live-action-param="add"
            data-product-name="{{ product.name }}"
            {{ sylius_test_html_attribute('wishlist-add-product') }}
    >
        <span>{{ wishlist.name }}</span>
    </button>
</li>
