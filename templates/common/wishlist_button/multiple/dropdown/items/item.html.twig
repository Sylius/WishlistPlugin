{% set wishlist = hookable_metadata.context.wishlist %}
{% set product = hookable_metadata.context.product %}
{% set product_in_this_wishlist = wishlist.hasProduct(product) %}

<li>
    <button
        type="button"
        class="dropdown-item d-flex align-items-center gap-2"
        data-action="live#action"
        data-live-action-param="{{ product_in_this_wishlist ? 'remove' : 'add' }}"
        data-live-wishlist-id-param="{{ wishlist.id }}"
        data-loading="addAttribute(disabled)"
        {{ sylius_test_html_attribute('wishlist-dropdown-item', wishlist.name) }}
    >
        {{ ux_icon(product_in_this_wishlist ? 'tabler:heart-filled' : 'tabler:heart', {
            'class': 'icon icon-xs' ~ (product_in_this_wishlist ? ' text-danger' : '')
        }) }}
        {{ wishlist.name }}
    </button>
</li>
